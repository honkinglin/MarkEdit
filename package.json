{
  "name": "markedit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "node --import tsx scripts/benchmark.tsx",
    "build:lib": "npm run build --workspace @markedit/react",
    "pack:lib": "npm run build:lib && node scripts/pack-library.mjs",
    "example:setup": "npm run pack:lib && npm install --prefix examples/react-consumer ./.benchmarks/markedit-react-0.1.0.tgz",
    "example:dev": "npm run dev --prefix examples/react-consumer",
    "example:build": "npm run build --prefix examples/react-consumer",
    "verify:lib": "npm run build:lib && node scripts/verify-package.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run verify:lib",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "release:report": "node scripts/release-report.mjs",
    "benchmark:browser": "node scripts/benchmark-browser.mjs",
    "benchmark:bundle": "node scripts/analyze-build.mjs",
    "check:bundle": "node scripts/analyze-build.mjs ci --check"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@uiw/react-codemirror": "^4.23.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^12.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/katex": "^0.16.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "$katex"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honkinglin/MarkEdit.git"
  },
  "engines": {
    "node": "24.x"
  }
}
