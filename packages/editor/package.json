  "description": "React Markdown editor and preview with CodeMirror 6, math and diagrams",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://github.com/honkinglin/MarkEdit#react-components",
  "bugs": {
    "url": "https://github.com/honkinglin/MarkEdit/issues"
  },
  "keywords": [
    "markdown",
    "react",
    "editor",
    "codemirror",
    "typescript",
    "mermaid",
    "katex"
  ]
}
